# Copy this file to .env.local and fill both values.
# .env.local is gitignored; never commit real credentials.
#
# Both come from the Supabase dashboard for your project:
#   Project Settings -> API
#
# The project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# The publishable key (starts with "sb_publishable_"). This is the browser-safe
# key and is shipped to the client, so row level security is what actually
# protects your data. Never put the secret or service_role key in this file.
VITE_SUPABASE_PUBLISHABLE_KEY=
